# Snyk (https://snyk.io) policy file
# Scope scanning to providers/teradata only.
# Every other directory is excluded explicitly (plain patterns, no negation).
exclude:
  global:
    - .agents/**
    - .apache-magpie-overrides/**
    - .claude/**
    - .devcontainer/**
    - .github/**
    - .vscode/**
    - airflow-core/**
    - airflow-ctl/**
    - airflow-ctl-tests/**
    - airflow-e2e-tests/**
    - chart/**
    - clients/**
    - constraints/**
    - contributing-docs/**
    - dags/**
    - dev/**
    - devel-common/**
    - docker-context-files/**
    - docker-stack-docs/**
    - docker-tests/**
    - docs/**
    - empty/**
    - generated/**
    - go-sdk/**
    - java-sdk/**
    - kubernetes-tests/**
    - manifests/**
    - performance/**
    - providers-summary-docs/**
    - registry/**
    - scripts/**
    - shared/**
    - task-sdk/**
    - task-sdk-integration-tests/**
    - ts-sdk/**
    - providers/.ast-grep/**
    - providers/airbyte/**
    - providers/akeyless/**
    - providers/alibaba/**
    - providers/amazon/**
    - providers/anthropic/**
